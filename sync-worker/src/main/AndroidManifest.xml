<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- SEC: exported=true is required for the broadcast framework to deliver these
             actions, but all four (BOOT_COMPLETED, LOCKED_BOOT_COMPLETED, TIMEZONE_CHANGED,
             TIME_SET) are protected broadcasts — only the system can send them (since API
             8.0 = minSdk 26), so the export is effectively inert and exposes no surface. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!--
                    Calendar schedules are converted to a fixed ms delay at enqueue
                    time, so a TZ/DST change would drift them (up to a week for a
                    weekly schedule). Re-run rescheduleAll() on clock/zone changes so
                    the next occurrence is recomputed against the new wall-clock time.
                -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!--
            SyncActionReceiver handles Cancel/Retry notification actions.
            Only reachable via explicit PendingIntents built in SyncNotifications;
            no intent-filter is needed (and exported=false prevents external callers).
        -->
        <receiver
            android:name=".SyncActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            WatchdogService + WatchdogReceiver are declared in app/src/main/AndroidManifest.xml
            (not here) even though the classes live in this module: that lets the
            `play` flavor strip them via a same-module tools:node="remove" in
            app/src/play/AndroidManifest.xml. A cross-module removal (declaring
            them here and removing from :app's flavor manifest) does not reliably
            match in AGP's manifest merger — the removal directive silently no-ops
            against elements contributed by a different Gradle module's manifest.
        -->
    </application>
</manifest>
